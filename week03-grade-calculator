function average (scores) {
    if (scores.length === 0) {
        return 0;
    }
    let total = 0;
for (const score of scores ){
    total += score;
}
return total / scores.length;
    
}

function isValidScore(score) {
  return score >= 0 && score <= 100; 
}
function getGrade(score){
  if (score >= 90) return "A";
  if (score >= 80) return "B";
  if (score >= 70) return "C";
  if (score >= 50) return "D";
  return "F";
}
let scores = process.argv.slice(2).map(Number); 
if (scores.length === 0) { scores = [72, 45, 91, 200, -34, 50]; }
let validScores = [];
 for (const score of scores) 
{ if (Number.isNaN(score)) {
     console.log(`{score} is not a number - skipping`); 
} 
else if (!isValidScore(score)) { 
    console.log(`Invalid score: ${score} - skipping`); 
} 
else { 
    console.log(`Score: ${score} = Grade: ${getGrade(score)}`); 
validScores.push(score); }
 }
console.log(`Average : ${average(validScores)}`)